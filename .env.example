# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Authentication & Security
JWT_ACCESS_SECRET="your-256-bit-access-secret-key-change-in-prod"
JWT_REFRESH_SECRET="your-256-bit-refresh-secret-key-change-in-prod"

# Database Configuration (Optional external PostgreSQL URL; defaults to embedded high-performance PostgreSQL engine)
DATABASE_URL="postgresql://user:password@localhost:5432/agency_db"
PORT=3000
NODE_ENV=development
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
